{
  "name": "mpr-altitude-logger",
  "private": true,
  "scripts": {
    "commands": "node -e \"const h=require('./scripts/help.cjs'); h()\"",
    "dev:tui": "python3 tools/launch.py",
    "dev:web": "cd tools/ground-station && pnpm dev:web",
    "simulator": "python3 tools/simulator_tui.py",
    "preflight": "cd tools/ground-station && pnpm dev:tui -- --mode preflight",
    "postflight": "cd tools/ground-station && pnpm dev:tui -- --mode postflight",
    "decode": "python3 tools/decode_log.py",
    "restate": "python3 tools/restate.py",
    "test": "cd /tmp && python3 -m pytest tests/ -v",
    "test:integration": "cd /tmp && python3 -m pytest tests/test_integration.py -v",
    "pico": "python3 tools/pico_diag_tui.py",
    "pico:diag": "python3 tools/pico_diag_tui.py",
    "deploy:pico": "cd tools/ground-station && pnpm deploy:pico",
    "version": "node -e \"const c=require('fs').readFileSync('config.py','utf8'); const v=c.match(/VERSION\\s*=\\s*\\\"(.+?)\\\"/); console.log('Firmware version: '+(v?v[1]:'unknown'))\""
  }
}
